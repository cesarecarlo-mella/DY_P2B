__pycache__/
.DS_Store
# per job only the configuration is in git; integral lists, Reduze's working folders and results not
jobs/*/*
!jobs/*/config/
!jobs/*/jobs.yaml
!jobs/*/run.sh
# test jobs (make_jobs.py test, or jobs --tag) not at all
jobs/*_*/
# FORM tables written by to_form.py from the Reduze results
tables/
